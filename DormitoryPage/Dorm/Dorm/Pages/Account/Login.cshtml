@page
@model Dorm.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="glass-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="brand-badge mx-auto mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-person-lock fs-3"></i>
            </div>
            <h2 class="fw-bold text-white mb-1">Welcome Back</h2>
            <p class="text-secondary small">Sign in to your Dormitory Management account</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 small">
                <i class="bi bi-exclamation-octagon me-1"></i> @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label text-secondary small fw-semibold">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                    <input asp-for="Input.Username" class="form-control form-control-dorm" placeholder="e.g. john_doe" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label text-secondary small fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                    <input asp-for="Input.Password" class="form-control form-control-dorm" type="password" placeholder="Enter your password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-gradient w-100 py-2 justify-content-center fw-bold mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
            </button>
        </form>

        <div class="text-center text-secondary small mt-3">
            Don't have an account? <a asp-page="/Account/Register" class="text-decoration-none" style="color: #818cf8;">Create Account</a>
        </div>

        <!-- Quick Demo Access -->
        <hr class="border-secondary border-opacity-25 my-4" />
        <p class="text-secondary small text-center mb-3">Quick Demo Access (Seeded Accounts)</p>
        <div class="d-flex flex-column gap-2">
            <form method="post" asp-page-handler="QuickSwitch">
                <input type="hidden" name="username" value="john_doe" />
                <button type="submit" class="btn btn-glass w-100 d-flex align-items-center gap-2 py-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 30px; height: 30px; background: var(--grad-emerald); font-size: 0.8rem;">J</div>
                    <div class="text-start">
                        <div class="text-white fw-semibold small">John Doe</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Tenant • john_doe / tenant123</small>
                    </div>
                    <i class="bi bi-arrow-right ms-auto text-secondary"></i>
                </button>
            </form>
            <form method="post" asp-page-handler="QuickSwitch">
                <input type="hidden" name="username" value="admin_maria" />
                <button type="submit" class="btn btn-glass w-100 d-flex align-items-center gap-2 py-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 30px; height: 30px; background: var(--grad-primary); font-size: 0.8rem;">M</div>
                    <div class="text-start">
                        <div class="text-white fw-semibold small">Maria Santos</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Admin/Landlord • admin_maria / admin123</small>
                    </div>
                    <i class="bi bi-arrow-right ms-auto text-secondary"></i>
                </button>
            </form>
        </div>
    </div>
</div>
