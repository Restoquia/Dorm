@page
@model Dorm.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="glass-card p-5">
                <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3.5rem;"></i>
                <h1 class="h2 text-white fw-bold mt-3">Something Went Wrong</h1>
                <p class="text-secondary mt-2">
                    An error occurred while processing your request. Please try again or contact the dormitory administrator.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small mt-3">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="mt-4">
                    <a asp-page="/Index" class="btn btn-primary-gradient px-4 py-2">
                        <i class="bi bi-house me-2"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
