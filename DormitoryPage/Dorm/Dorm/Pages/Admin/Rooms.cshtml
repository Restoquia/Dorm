@page
@model Dorm.Pages.Admin.RoomsModel
@{
    ViewData["Title"] = "Room Inventory Management";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <span class="text-uppercase text-xs fw-bold tracking-wider text-info">Admin Panel</span>
            <h1 class="h2 fw-bold text-white mb-1">Room Inventory</h1>
            <p class="text-secondary mb-0">Manage all rooms across dormitory buildings. Create, update status, and remove units.</p>
        </div>
        <button class="btn btn-primary-gradient" data-bs-toggle="modal" data-bs-target="#addRoomModal">
            <i class="bi bi-plus-circle me-1"></i> Add New Room
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessageType == "error" ? "alert-danger bg-danger text-white border-0" : "alert-success bg-success text-white border-0") alert-dismissible fade show shadow-lg mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filters -->
    <div class="glass-card p-3 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-secondary small fw-semibold">Filter by Building</label>
                <select name="DormitoryId" class="form-select form-select-dorm">
                    <option value="">All Dormitories</option>
                    @foreach (var d in Model.Dormitories)
                    {
                        <option value="@d.DormitoryId" selected="@(Model.DormitoryId == d.DormitoryId)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-secondary small fw-semibold">Status</label>
                <select name="Status" class="form-select form-select-dorm">
                    <option value="">All Status</option>
                    <option value="Available" selected="@(Model.Status == "Available")">Available</option>
                    <option value="Occupied" selected="@(Model.Status == "Occupied")">Occupied</option>
                    <option value="Maintenance" selected="@(Model.Status == "Maintenance")">Under Maintenance</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-glass w-100"><i class="bi bi-funnel me-1"></i> Apply Filters</button>
            </div>
        </form>
    </div>

    <!-- Rooms Table -->
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dorm mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Room #</th>
                        <th>Building</th>
                        <th>Type</th>
                        <th>Capacity</th>
                        <th>Occupants</th>
                        <th>Monthly Rate</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td class="text-muted">@room.RoomId</td>
                            <td class="fw-semibold text-white">@room.RoomNumber</td>
                            <td>@room.DormitoryName</td>
                            <td><span class="badge bg-dark border border-secondary">@room.RoomType</span></td>
                            <td>@room.Capacity</td>
                            <td>
                                <span class="fw-bold @(room.CurrentOccupants >= room.Capacity ? "text-danger" : "text-success")">@room.CurrentOccupants</span> / @room.Capacity
                            </td>
                            <td class="text-success fw-bold">₱@room.MonthlyRate.ToString("N0")</td>
                            <td>
                                <span class="badge badge-status @(room.Status == "Available" ? "badge-available" : room.Status == "Occupied" ? "badge-occupied" : "badge-maintenance")">
                                    @room.Status
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (room.Status != "Maintenance")
                                    {
                                        <form method="post" asp-page-handler="Status">
                                            <input type="hidden" name="roomId" value="@room.RoomId" />
                                            <input type="hidden" name="newStatus" value="Maintenance" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning border-warning" title="Set Maintenance">
                                                <i class="bi bi-wrench"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (room.Status == "Maintenance")
                                    {
                                        <form method="post" asp-page-handler="Status">
                                            <input type="hidden" name="roomId" value="@room.RoomId" />
                                            <input type="hidden" name="newStatus" value="Available" />
                                            <button type="submit" class="btn btn-sm btn-outline-success border-success" title="Mark Available">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this room?')">
                                        <input type="hidden" name="roomId" value="@room.RoomId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-danger" title="Delete Room">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small pt-3">Showing @Model.Rooms.Count rooms total</div>
    </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dorm">
            <div class="modal-header modal-header-dorm">
                <h5 class="modal-title text-white fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i> Add New Room</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-secondary small fw-semibold">Dormitory Building</label>
                            <select asp-for="NewRoom.DormitoryId" class="form-select form-select-dorm" required>
                                <option value="">Select building...</option>
                                @foreach (var d in Model.Dormitories)
                                {
                                    <option value="@d.DormitoryId">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-semibold">Room Number</label>
                            <input asp-for="NewRoom.RoomNumber" class="form-control form-control-dorm" placeholder="e.g. Room 205" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-semibold">Room Type</label>
                            <select asp-for="NewRoom.RoomType" class="form-select form-select-dorm" required>
                                <option value="Single Private">Single Private</option>
                                <option value="Double Sharing">Double Sharing</option>
                                <option value="Deluxe Studio">Deluxe Studio</option>
                                <option value="Bedspace Dormitory">Bedspace Dormitory</option>
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-semibold">Capacity</label>
                            <input asp-for="NewRoom.Capacity" type="number" class="form-control form-control-dorm" min="1" max="10" value="1" required />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-semibold">Monthly Rate (₱)</label>
                            <input asp-for="NewRoom.MonthlyRate" type="number" class="form-control form-control-dorm" step="100" min="500" placeholder="4500" required />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-semibold">Status</label>
                            <select asp-for="NewRoom.Status" class="form-select form-select-dorm">
                                <option value="Available">Available</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer modal-footer-dorm">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-gradient"><i class="bi bi-plus-circle me-1"></i> Create Room</button>
                </div>
            </form>
        </div>
    </div>
</div>
