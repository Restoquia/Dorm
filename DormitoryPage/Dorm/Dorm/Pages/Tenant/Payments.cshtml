@page
@model Dorm.Pages.Tenant.PaymentsModel
@{
    ViewData["Title"] = "Rent Payments & Billing";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="mb-4">
        <span class="text-uppercase text-xs fw-bold tracking-wider text-success">Financial Center</span>
        <h1 class="h2 fw-bold text-white mb-1">Rent Payments & Statement of Account</h1>
        <p class="text-secondary mb-0">View your billing history, remaining balance, and submit new rent payments.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessageType == "error" ? "alert-danger bg-danger text-white border-0" : Model.StatusMessageType == "warning" ? "alert-warning" : "alert-success bg-success text-white border-0") alert-dismissible fade show shadow-lg mb-4" role="alert">
            <i class="bi @(Model.StatusMessageType == "error" ? "bi-exclamation-octagon" : "bi-check-circle-fill") me-2"></i>
            @Model.StatusMessage
            <button type="button" class="btn-close @(Model.StatusMessageType != "warning" ? "btn-close-white" : "")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Lease Selector -->
    @if (Model.ActiveLeases.Count > 1)
    {
        <div class="glass-card p-3 mb-4">
            <form method="get" class="d-flex align-items-center gap-3">
                <label class="text-secondary fw-semibold small text-nowrap">Select Lease:</label>
                <select name="leaseId" class="form-select form-select-dorm" onchange="this.form.submit()">
                    @foreach (var lease in Model.ActiveLeases)
                    {
                        <option value="@lease.LeaseId" selected="@(Model.LeaseId == lease.LeaseId)">
                            @lease.RoomNumber — @lease.DormitoryName (₱@lease.MonthlyRate.ToString("N0")/mo)
                        </option>
                    }
                </select>
            </form>
        </div>
    }

    @if (Model.StatementOfAccount != null)
    {
        var soa = Model.StatementOfAccount;
        <div class="row g-4">
            <!-- Left: SOA & Payment History -->
            <div class="col-lg-7">
                <!-- Balance Summary -->
                <div class="glass-card p-4 mb-4">
                    <h4 class="fw-bold text-white mb-3"><i class="bi bi-receipt-cutoff text-info me-2"></i> Statement of Account</h4>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <div class="p-3 rounded text-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25);">
                                <small class="text-secondary" style="font-size: 0.7rem;">TOTAL PAID</small>
                                <div class="fw-bold text-success fs-4">₱@soa.TotalPaid.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 rounded text-center" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25);">
                                <small class="text-secondary" style="font-size: 0.7rem;">EXPECTED TOTAL</small>
                                <div class="fw-bold text-white fs-4">₱@soa.ExpectedTotalRent.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 rounded text-center" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25);">
                                <small class="text-secondary" style="font-size: 0.7rem;">REMAINING BALANCE</small>
                                <div class="fw-bold @(soa.RemainingBalance > 0 ? "text-warning" : "text-success") fs-4">₱@soa.RemainingBalance.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 text-secondary small">
                        <div class="col-sm-4"><strong>Room:</strong> @soa.RoomNumber</div>
                        <div class="col-sm-4"><strong>Rate:</strong> ₱@soa.MonthlyRate.ToString("N0")/mo</div>
                        <div class="col-sm-4"><strong>Term:</strong> @soa.TotalMonths months</div>
                    </div>
                </div>

                <!-- Payment History Table -->
                <div class="glass-card p-4">
                    <h5 class="fw-bold text-white mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Payment History</h5>
                    @if (soa.Payments.Count == 0)
                    {
                        <p class="text-secondary small">No payments recorded yet for this lease.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dorm table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in soa.Payments.OrderByDescending(p => p.PaymentDate))
                                    {
                                        <tr>
                                            <td class="text-muted">@p.PaymentId</td>
                                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-dark border border-secondary text-white">@p.PaymentMethod</span>
                                            </td>
                                            <td class="text-muted small">@(p.ReferenceNumber ?? "—")</td>
                                            <td class="text-end fw-bold text-success">₱@p.AmountPaid.ToString("N2")</td>
                                            <td><span class="badge badge-status badge-approved">@p.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Pay Rent Form -->
            <div class="col-lg-5">
                <div class="glass-card p-4 position-sticky" style="top: 90px;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-credit-card-2-front text-success fs-4"></i>
                        <h4 class="text-white fw-bold mb-0">Record Rent Payment</h4>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="PaymentInput.LeaseId" value="@Model.LeaseId" />

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Amount to Pay (₱)</label>
                            <input type="number" asp-for="PaymentInput.AmountPaid" class="form-control form-control-dorm" step="0.01" min="1" placeholder="@soa.MonthlyRate.ToString("N2")" value="@soa.MonthlyRate" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Payment Method</label>
                            <select asp-for="PaymentInput.PaymentMethod" class="form-select form-select-dorm">
                                <option value="GCash">GCash</option>
                                <option value="Maya">Maya / PayMaya</option>
                                <option value="Cash">Cash (Over-the-Counter)</option>
                                <option value="Bank Transfer">Bank Transfer (BDO/BPI)</option>
                                <option value="Credit Card">Credit Card</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Reference / Transaction Number</label>
                            <input asp-for="PaymentInput.ReferenceNumber" class="form-control form-control-dorm" placeholder="e.g. GCASH-1234567890" />
                        </div>

                        <input type="hidden" asp-for="PaymentInput.Status" value="Completed" />

                        <div class="p-3 mb-3 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-secondary">Current Balance:</span>
                                <span class="text-warning fw-bold">₱@soa.RemainingBalance.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-secondary">Monthly Rate:</span>
                                <span class="text-white">₱@soa.MonthlyRate.ToString("N2")</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-emerald-gradient w-100 py-2 justify-content-center fw-bold">
                            <i class="bi bi-send-check me-2"></i> Submit Payment
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveLeases.Count == 0)
    {
        <div class="glass-card text-center py-5">
            <i class="bi bi-wallet2 text-secondary" style="font-size: 3.5rem;"></i>
            <h4 class="text-white mt-3">No active leases found</h4>
            <p class="text-muted">You need an active lease agreement before making rent payments.</p>
            <a asp-page="/Index" class="btn btn-primary-gradient">Browse Available Rooms</a>
        </div>
    }
</div>
